fn skip_whitespace ( code code_len i -- new_i )
  local ch
  while i code_len < i code b[] dup -> ch 32 == ch 10 == or ch 9 == or ch 13 == or and do
    if ch 10 == then 1 +=> line_cnt endif
    1 +=> i
  endwhile
  i return
endfn

fn skip_comment ( code code_len i -- new_i )
  while i code_len < i code b[] 35 == and do
    1 +=> i
    "comment begin: " errs
    while i code_len < i code b[] 10 != and do
      1 +=> i
    endwhile
    "comment end\n" errs
    1 +=> line_cnt
    1 +=> i
    code code_len i skip_whitespace -> i
  endwhile
  i return
endfn

fn get_tokens ( tokens token_cnt -- new_tokens_cnt )
  local i
  0 -> i
  while i code_len < do
    code code_len i skip_whitespace -> i
    code code_len i skip_comment -> i
    code code_len i skip_whitespace -> i

    local start
    code i + -> start
    if i code_len < i code b[] 34 == and then
      1 +=> i
      while i code_len < i code b[] 34 == i 1 - code b[] 92 == and i code b[] 34 != or and do
        1 +=> i
      endwhile
    else 
      while i code_len < i code b[] 32 != i code b[] 10 != and and do
        1 +=> i
      endwhile
      if i code b[] 10 == then 1 +=> line_cnt endif
    endif
    0 i code b[]=
    start token_cnt tokens []=

    line_cnt token_cnt tokens_line_number []=
    1 +=> token_cnt
    1 +=> i
  endwhile
  token_cnt return
endfn

