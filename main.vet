    ".FN_" prints cur_func_name prints ":\n" prints
    "push rbp\nmov rbp, rsp\n" prints
    if cur_func_input_count then
      1 -> k
      while k cur_func_input_count <= do
        "push " prints k funcs_para_regs [] prints nl
        1 +=> k
      endwhile
    endif
    cur_func_idx funcs_variable_cnt b[] -> cur_func_var_cnt
    if cur_func_input_count cur_func_var_cnt < then
      "sub rsp, " prints cur_func_var_cnt cur_func_input_count - 8 * printi nl
    endif
    1 +=> i
    if i tokens [] "(" streq then
      1 +=> i
      while i tokens [] ")" streq not do
        1 +=> i
      endwhile
    endif
  elif t "return" streq then
    "jmp .L_RET_FN_" prints cur_func_name prints nl
  elif t "endfn" streq then
    ".L_RET_FN_" prints cur_func_name prints ":\n" prints
    if cur_func_output_count 1 == then
      "pop rax\n" prints
    elif cur_func_output_count 2 == then
      "pop rdx\npop rax\n" prints
    endif
    "mov rsp, rbp\npop rbp\n" prints
    "ret\n" prints
    ".L_SKIP_FN_" prints cur_func_name prints ":\n" prints
    0 -> cur_func_name
    0 -> cur_func_input_count
    0 -> cur_func_output_count
    0 -> cur_func_idx
  elif t "local" streq then
    1 +=> i
    # TODO: skip local variable
  elif cur_func_name cur_func_idx funcs_variable_start [] cur_func_idx funcs_variable_cnt b[] t find_name dup -> local_var_idx -1 != and then
    "mov rax, [rbp-" prints local_var_idx 1 + 8 * printi "]\n" prints
    "push rax\n" prints
  elif variables variables_cnt t find_name -1 != then
    "mov rax, [" prints t prints "]\n" prints
    "push rax\n" prints
  elif funcs funcs_cnt t find_name dup -> func_idx -1 != then
    func_idx funcs_input b[] -> input_cnt
    func_idx funcs_output b[] -> output_cnt
    if input_cnt then
      input_cnt -> k
      while k do
        "pop " prints k funcs_para_regs [] prints nl
        1 -=> k
      endwhile
    endif
    if func_idx funcs_is_extern b[] then
      "call " prints t prints nl
    else
      "call .FN_" prints t prints nl
    endif
    if output_cnt then
      output_cnt -> k
      while k do
        "push " prints k funcs_ret_regs [] prints nl
        1 -=> k
      endwhile
    endif
  elif ops_name ops_cnt t find_name dup -> ops_idx -1 != then
    ops_idx ops_code [] prints
  else
    if 0 t b[] 0 != then
      i tokens_line_number [] erri ":Symbol Error: Unknown symbol '" errs t errs "'\n" errs
      1 exit
    endif
  endif
  1 +=> i
endwhile

