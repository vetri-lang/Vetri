  i tokens [] str2int -> alloc_size
  if alloc_size then
    alloc_size alloc_cnt alloc_cells []=
    1 +=> alloc_cnt
  endif
  i return
endfn

fn prescan_extern_fn ( tokens token_cnt i -- new_i )
  1 +=> i
  local func_name
  i tokens [] -> func_name
  "try to find " errs func_name errs " in funcs[]\n" errs
  if func_name then
    "start searching " errs func_name errs errnl
    if funcs funcs_cnt func_name find_name -1 == then
      func_name funcs_cnt funcs []=
      "append " errs func_name errs " to funcs[]\n" errs
      1 +=> i
      tokens token_cnt i 0 prescan_fn_args -> i
      1 funcs_cnt funcs_is_extern b[]=
      1 +=> funcs_cnt
    else
      func_name errs " exists\n" errs
    endif
  endif
  i return
endfn

fn prescan_fn ( tokens token_cnt i cur_func_name -- new_i new_cur_func_name )
  i funcs_cnt funcs_token_start []=
  1 +=> i
  if cur_func_name then
    i tokens_line_number erri ":Invalid nesting function declaration\n" errs
    1 exit
  endif
  i tokens [] -> cur_func_name
  "try to find " errs cur_func_name errs " in funcs[]\n" errs
  if cur_func_name then
    "start searching " errs cur_func_name errs errnl
    if funcs funcs_cnt cur_func_name find_name -1 == then
      cur_func_name funcs_cnt funcs []=
      "append " errs cur_func_name errs " to funcs[]\n" errs
      local_variables local_variables_cnt 8 * + funcs_cnt funcs_variable_start []=
      0 funcs_cnt funcs_variable_cnt b[]=
      1 +=> i
      tokens token_cnt i 1 prescan_fn_args -> i
      0 funcs_cnt funcs_is_extern b[]=
    else
      cur_func_name errs " exists\n" errs
      1 exit
    endif
  endif
  i cur_func_name return
endfn

fn prescan_assignment ( tokens token_cnt i cur_func_name -- new_i )
  1 +=> i
  local var_name
  i tokens [] -> var_name
  if var_name then
    if cur_func_name funcs_cnt funcs_variable_start [] funcs_cnt funcs_variable_cnt b[] var_name find_name -1 != and then
      "find local variable: " errs var_name errs errnl
    else
      if variables variables_cnt var_name find_name -1 == then
        var_name variables_cnt variables []=
        1 +=> variables_cnt
      endif
    endif
  endif
  i return
endfn

fn prescan_local ( tokens token_cnt i cur_func_name -- new_i )
  1 +=> i
  local local_var_name
  i tokens [] -> local_var_name
  local cur_func_var_cnt
  funcs_cnt funcs_variable_cnt b[] -> cur_func_var_cnt
  if cur_func_name then
    local_var_name local_variables_cnt local_variables []=
    1 +=> local_variables_cnt
    1 +=> cur_func_var_cnt
  endif
  cur_func_var_cnt funcs_cnt funcs_variable_cnt b[]=
  i return
endfn

fn prescan_struct ( tokens token_cnt i -- new_i )
  1 +=> i
  local cur_struct_name
  i tokens [] -> cur_struct_name
  1 +=> i
  cur_struct_name structs_cnt structs []=
  fields fields_cnt 8 * + structs_cnt structs_field_start []=
  local cur_field
  local cur_field_cnt
  0 -> cur_field_cnt
  while i token_cnt < i tokens [] dup -> cur_field "endstruct" streq not do
    cur_field fields_cnt fields []=
    1 +=> fields_cnt
    1 +=> cur_field_cnt
    1 +=> i
  endwhile
  cur_field_cnt structs_cnt structs_field_cnt []=
  1 +=> structs_cnt
  i return
endfn

fn prescan_new ( tokens token_cnt i -- new_i )
  1 +=> i
  local cur_struct_name
  i tokens [] -> cur_struct_name
  if 0 cur_struct_name b[] 64 == then
    "skip @\n" errs
    1 +=> cur_struct_name
  endif
  local cur_struct_num
  1 -> cur_struct_num
  if i 1 + tokens [] is_valid_integer then
    1 +=> i
    i tokens [] str2int -> cur_struct_num
  endif
  local cur_struct_idx
  if structs structs_cnt cur_struct_name find_name dup -> cur_struct_idx -1 != then
    local alloc_size
    cur_struct_idx structs_field_cnt [] cur_struct_num * -> alloc_size
    alloc_size alloc_cnt alloc_cells []=
    1 +=> alloc_cnt
  else
    i tokens_line_number [] erri ":Type Error: Unknown struct '" errs cur_struct_name errs "'\n" errs
    1 exit
  endif
  i return
endfn

fn prescan ( tokens token_cnt -- )
  "prescan begin:\n" errs
  local cur_func_name
  0 -> cur_func_name
  local i
  0 -> i
  while i token_cnt < do
    local t
    i tokens [] -> t
    if 0 t b[] 34 == then
      tokens token_cnt i prescan_string -> i
    elif t "alloc" streq then
      tokens token_cnt i prescan_alloc_cell -> i
    elif t "extern" streq then
      tokens token_cnt i prescan_extern_fn -> i
    elif t "fn" streq then
      tokens token_cnt i cur_func_name prescan_fn -> i -> cur_func_name
    elif t "->" streq then
      tokens token_cnt i cur_func_name prescan_assignment -> i
    elif t "local" streq then
      tokens token_cnt i cur_func_name prescan_local -> i
    elif t "endfn" streq then
      i funcs_cnt funcs_token_end []=
      1 +=> funcs_cnt
      0 -> cur_func_name
    elif t "struct" streq then
      tokens token_cnt i prescan_struct -> i
    elif t "new" streq then
      tokens token_cnt i prescan_new -> i
    endif
    1 +=> i
  endwhile
  "prescan end\n" errs
endfn

tokens token_cnt prescan

