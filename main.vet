fn find_name ( array array_len value -- idx )
  0 -> find_name_i
  -1 -> find_name_res_idx
  while find_name_i @2 < find_name_res_idx -1 == and do
    if find_name_i @1 [] @3 streq then
      find_name_i -> find_name_res_idx
    endif
    1 +=> find_name_i
  endwhile
  find_name_res_idx return
endfn

