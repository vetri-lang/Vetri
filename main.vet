fn find_name ( array array_len value -- idx )
  if array not then -1 return endif
  local i
  0 -> i
  while i array_len < do
    if i array [] then
      if i array [] value streq then
        i return
      endif
    endif
    1 +=> i
  endwhile
  -1 return
endfn

fn debug_find_name ( array array_len value -- idx )
  if array not then
    "Null array point\n" errs
    -1 return
  endif
  local i
  0 -> i
  while i array_len < do
    if i array [] then
      "Comparing " errs i array [] errs " and " errs value errs
      if i array [] value streq then
        " match!\n" errs
        i return
      endif
      " unmatch, continue\n" errs
    endif
    1 +=> i
  endwhile
  "No result\n" errs
  -1 return
endfn

fn prescan_fn_args ( tokens token_cnt i not_extern -- new_i )
  if i tokens [] "(" streq then
    1 +=> i
    0 -> cur_func_input_count
    while i token_cnt < i tokens [] "--" streq not and do
      if not_extern then
        i tokens [] local_variables_cnt local_variables []=
        1 +=> local_variables_cnt
      endif
      1 +=> cur_func_input_count
      1 +=> i
    endwhile
    "input: " errs cur_func_input_count erri
    cur_func_input_count funcs_cnt funcs_input b[]=
    1 +=> i
    0 -> cur_func_output_count
    while i token_cnt < i tokens [] ")" streq not and do
      if not_extern then
        i tokens [] local_variables_cnt local_variables []=
        1 +=> local_variables_cnt
      endif
      1 +=> cur_func_output_count
      1 +=> i
    endwhile
    " output: " errs cur_func_output_count erri errnl
    cur_func_output_count funcs_cnt funcs_output b[]=
    if not_extern then
      cur_func_input_count cur_func_output_count + funcs_cnt funcs_variable_cnt b[]=
    endif
  endif
  i return
endfn

fn prescan_string ( tokens token_cnt i -- new_i )
  local t
  i tokens [] -> t
  if strings str_cnt t find_name -1 == then
    t str_cnt strings []=
    1 +=> str_cnt
  endif
  i return
endfn

fn str2int ( s -- x )
  local ch
  local k
  0 -> k
  0 -> x
  while k s b[] dup -> ch 0 != do
    ch 48 - x 10 * + -> x
    1 +=> k
  endwhile
  x return
endfn

fn is_valid_integer ( s -- flag )
  if 0 s b[] 0 == then 0 return endif
  local i
  local ch
  0 -> i
  i s b[] -> ch
  if ch 43 == ch 45 == or then 1 +=> i endif
  if i s b[] 0 == then 0 return endif
  while i s b[] dup -> ch do
    if ch 48 < ch 57 > or then 0 return endif
    1 +=> i
  endwhile
  1 return
endfn

fn prescan_alloc_cell ( tokens token_cnt i -- new_i )
