      endif
    elif t "endfn" streq then
      if is_fn then
        tokens token_cnt i cur_func_idx parse_and_emit_endfn -> i -> cur_func_idx
      endif
    elif t "local" streq then
      1 +=> i # TODO: skip local variable
    elif t "struct" streq then
      tokens token_cnt i parse_and_skip_struct -> i
    elif local local_var_idx tokens token_cnt i cur_func_idx is_local_variable -> i dup -> local_var_idx -1 != then
      "mov rax, [rbp-" prints local_var_idx 1 + 8 * printi "]\n" prints
      "push rax\n" prints
    elif variables variables_cnt t find_name -1 != then
      "mov rax, [" prints t prints "]\n" prints
      "push rax\n" prints
    elif local func_idx funcs funcs_cnt t find_name dup -> func_idx -1 != then
