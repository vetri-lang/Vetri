fn parse_and_emit ( tokens token_cnt is_fn -- )
  local cur_func_idx
  -1 -> cur_func_idx
  local i
  0 -> i
  while i token_cnt < do
    local t
    i tokens [] -> t
    if t is_valid_integer then
      tokens token_cnt i parse_and_emit_integer -> i
    elif 0 t b[] 34 == then
      tokens token_cnt i parse_and_emit_string -> i
    elif t "if" streq then
      tokens token_cnt i parse_and_emit_if -> i
    elif t "elif" streq then
      tokens token_cnt i parse_and_emit_elif -> i
    elif t "then" streq then
      tokens token_cnt i parse_and_emit_then -> i
    elif t "else" streq then
      tokens token_cnt i parse_and_emit_else -> i
    elif t "endif" streq then
      tokens token_cnt i parse_and_emit_endif -> i
    elif t "while" streq then
      tokens token_cnt i parse_and_emit_while -> i
    elif t "do" streq then
      tokens token_cnt i parse_and_emit_do -> i
    elif t "endwhile" streq then
      tokens token_cnt i parse_and_emit_endwhile -> i
    elif t "->" streq then
      tokens token_cnt i cur_func_idx parse_and_emit_assignment -> i
    elif t "+=>" streq then
      tokens token_cnt i cur_func_idx parse_and_emit_add_and_assign -> i
    elif t "-=>" streq then
      tokens token_cnt i cur_func_idx parse_and_emit_sub_and_assign -> i
    elif t "*=>" streq then
      tokens token_cnt i cur_func_idx parse_and_emit_mul_and_assign -> i
    elif t "/=>" streq then
      tokens token_cnt i cur_func_idx parse_and_emit_div_and_assign -> i
    elif t "%=>" streq then
      tokens token_cnt i cur_func_idx parse_and_emit_mod_and_assign -> i
    elif t "." streq then
      tokens token_cnt i parse_and_emit_dot -> i
    elif t ".=" streq then
      tokens token_cnt i parse_and_emit_dot_assign -> i
    elif t "[]" streq then
      tokens token_cnt i parse_and_emit_index -> i
    elif t "alloc" streq then
      tokens token_cnt i alloc_idx parse_and_emit_alloc -> i -> alloc_idx
    elif t "new" streq then
      tokens token_cnt i alloc_idx parse_and_emit_new -> i -> alloc_idx
    elif t "extern" streq then
      "find extern\n" errs
    elif t "fn" streq then
      if is_fn then
