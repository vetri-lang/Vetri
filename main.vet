fn emit_head ( -- )
  "default rel\n" prints
  declare_fn
  "global _start\n" prints
  "section .data\n" prints
  declare_strings
  "section .bss\n" prints
  declare_alloc_cells
  declare_variables
  "section .text\n" prints
  "_start:\n" prints
  "mov rbp, rsp\n" prints
  "mov rax, [rbp]\n" prints
  "lea rbx, [rbp + 8]\n" prints
  "mov [argc], rax\n" prints
  "mov [argv], rbx\n" prints
endfn

emit_head

