fn is_valid_integer ( s -- flag )
  if 0 s b[] 0 == then 0 return endif
  local i
  local ch
  0 -> i
  i s b[] -> ch
  if ch 43 == ch 45 == or then 1 +=> i endif
  if i s b[] 0 == then 0 return endif
  while i s b[] dup -> ch do
    if ch 48 < ch 57 > or then 0 return endif
    1 +=> i
  endwhile
  1 return
endfn

