fn find_name ( array array_len value -- idx )
  if array not then -1 return endif
  local i
  0 -> i
  while i array_len < do
    if i array [] then
      if i array [] value streq then
        i return
      endif
    endif
    1 +=> i
  endwhile
  -1 return
endfn

fn prescan_fn_args ( i not_extern -- new_i )
  if i tokens [] "(" streq then
    1 +=> i
    0 -> cur_func_input_count
    while i tokens [] "--" streq not do
      if not_extern then
        i tokens [] local_variables_cnt local_variables []=
        1 +=> local_variables_cnt
      endif
      1 +=> cur_func_input_count
      1 +=> i
    endwhile
    "input: " errs cur_func_input_count erri
    cur_func_input_count funcs_cnt funcs_input b[]=
    1 +=> i
    0 -> cur_func_output_count
    while i tokens [] ")" streq not do
      if not_extern then
        i tokens [] local_variables_cnt local_variables []=
        1 +=> local_variables_cnt
      endif
      1 +=> cur_func_output_count
      1 +=> i
    endwhile
    " output: " errs cur_func_output_count erri errnl
    cur_func_output_count funcs_cnt funcs_output b[]=
    if not_extern then
      cur_func_input_count cur_func_output_count + funcs_cnt funcs_variable_cnt b[]=
    endif
  endif
  i return
endfn

